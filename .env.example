NODE_ENV=development
# Runtime connection; use the Supabase pooler URL for the API.
DATABASE_URL=postgresql://loanplus:loanplus_dev_only@localhost:5432/loanplus?schema=public
# Direct connection; use the Supabase direct PostgreSQL URL for Prisma migrations.
DIRECT_URL=postgresql://loanplus:loanplus_dev_only@localhost:5432/loanplus?schema=public
DATABASE_HOST=postgres
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Keep this local for development; Render production must use the exact Vercel site origin.
WEB_ORIGIN=http://localhost:3000
# Keep this local for development; Vercel Production must use the Render API base URL.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
OTP_HASH_KEY=replace-with-a-different-random-secret-at-least-32-characters
ID_ENCRYPTION_KEY_BASE64=replace-with-base64-encoded-32-byte-key
ID_HASH_KEY=replace-with-a-different-random-secret-at-least-32-characters
# Development-only placeholders: the published legal pages are unapproved drafts.
# Never use these placeholders in production; configure approved document versions only after review.
TERMS_VERSION=draft-v1
PRIVACY_VERSION=draft-v1
SUPERADMIN_EMAIL=operator@example.invalid
SUPERADMIN_EMAIL_VERIFIED=false
RESEND_API_KEY=
RESEND_FROM=LoanPlus <no-reply@example.invalid>
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Daraja BusinessShortCode used for the STK password and status query.
MPESA_SHORT_CODE=
# Required for CustomerBuyGoodsOnline; provide the Safaricom-confirmed Till separately.
MPESA_TILL_NUMBER=
MPESA_PASSKEY=
# PayBill or Buy Goods; confirm the configured production business type with Safaricom.
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# STK Push callback base only; production must use the public API host and exact route.
# The API appends a per-payment token. Never use a C2B v2 validation/confirmation URL here.
MPESA_CALLBACK_URL=
MPESA_LIVE_ENABLED=false
# Activation policy approval writes are rejected unless this explicitly equals "staging".
ACTIVATION_POLICY_APPROVAL_ENVIRONMENT=development