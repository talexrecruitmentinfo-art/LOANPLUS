generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  NORMAL_USER
  SUPERADMIN
}

enum IdentityStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  NEEDS_REVIEW
}

enum ActivationStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum LoanApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  ACCEPTED
  CANCELLED
}

enum LoanStatus {
  DISBURSEMENT_PENDING
  DISBURSED
  REPAYMENT_IN_PROGRESS
  REPAID
  OVERDUE
  CANCELLED
}

enum DisbursementStatus {
  PENDING
  CONFIRMED
  FAILED
  REVERSED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  EXPIRED
  REVERSED
}

enum PaymentType {
  ACTIVATION
  REPAYMENT
  DISBURSEMENT
  WITHDRAWAL
  REFUND
}

enum LedgerTransactionStatus {
  POSTED
  REVERSED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum ReferralStatus {
  REGISTERED
  ACTIVATION_PENDING
  QUALIFIED
  REWARD_PENDING
  REWARDED
  REJECTED
  UNDER_REVIEW
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

model User {
  id                   String                     @id @default(cuid())
  role                 Role                       @default(NORMAL_USER)
  fullName             String                     @db.VarChar(160)
  email                String                     @unique @db.VarChar(254)
  phone                String                     @unique @db.VarChar(16)
  nationalIdCiphertext String                     @db.Text
  nationalIdHash       String                     @unique @db.VarChar(64)
  referralCode         String?                    @unique @db.VarChar(24)
  passwordHash         String                     @db.VarChar(100)
  identityStatus       IdentityStatus             @default(NOT_STARTED)
  activationStatus     ActivationStatus           @default(PENDING)
  isActive             Boolean                    @default(true)
  termsVersion         String                     @db.VarChar(40)
  privacyVersion       String                     @db.VarChar(40)
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  sessions             CustomerSession[]
  consents             ConsentRecord[]
  passwordResetTokens  PasswordResetToken[]
  loanApplications     LoanApplication[]
  loans                Loan[]
  paymentTransactions  PaymentTransaction[]
  activationPayments   ActivationPaymentRequest[]
  ledgerAccounts       LedgerAccount[]
  referralsSent        Referral[]                 @relation("ReferralReferrer")
  referralReceived     Referral?                  @relation("ReferralReferred")
  withdrawalRequests   WithdrawalRequest[]
  supportTickets       SupportTicket[]

  @@index([createdAt])
  @@index([identityStatus])
  @@map("users")
}

model ConsentRecord {
  id          String   @id @default(cuid())
  userId      String
  consentType String   @db.VarChar(40)
  version     String   @db.VarChar(40)
  acceptedAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, consentType, version])
  @@index([userId, acceptedAt])
  @@map("consent_records")
}

model CustomerSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("customer_sessions")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model SuperadminUser {
  id                            String                         @id @default(cuid())
  role                          Role                           @default(SUPERADMIN)
  email                         String                         @unique @db.VarChar(254)
  passwordHash                  String                         @db.VarChar(100)
  isActive                      Boolean                        @default(true)
  emailVerifiedAt               DateTime?
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  sessions                      SuperadminSession[]
  challenges                    SuperadminOtpChallenge[]
  auditEvents                   AdminAuditLog[]
  reviewedLoanApplications      LoanApplication[]
  systemSettings                SystemSetting[]
  loanDisbursements             LoanDisbursement[]
  paymentReconciliationAttempts PaymentReconciliationAttempt[]

  @@map("superadmin_users")
}

model SuperadminOtpChallenge {
  id            String         @id @default(cuid())
  superadminId  String
  otpHash       String         @db.VarChar(64)
  expiresAt     DateTime
  attempts      Int            @default(0)
  consumedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime       @default(now())
  superadmin    SuperadminUser @relation(fields: [superadminId], references: [id], onDelete: Restrict)

  @@index([superadminId, expiresAt])
  @@map("superadmin_otp_challenges")
}

model SuperadminSession {
  id           String         @id @default(cuid())
  superadminId String
  tokenHash    String         @unique @db.VarChar(64)
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime       @default(now())
  superadmin   SuperadminUser @relation(fields: [superadminId], references: [id], onDelete: Restrict)

  @@index([superadminId, expiresAt])
  @@map("superadmin_sessions")
}

model AdminAuditLog {
  id           String          @id @default(cuid())
  superadminId String?
  action       String          @db.VarChar(80)
  subjectType  String?         @db.VarChar(80)
  subjectId    String?         @db.VarChar(80)
  outcome      String          @db.VarChar(40)
  reason       String?         @db.VarChar(500)
  ipAddress    String?         @db.VarChar(64)
  createdAt    DateTime        @default(now())
  superadmin   SuperadminUser? @relation(fields: [superadminId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([superadminId, createdAt])
  @@map("admin_audit_logs")
}

model AuthAuditLog {
  id        String   @id @default(cuid())
  actorType String   @db.VarChar(20)
  actorId   String?  @db.VarChar(80)
  action    String   @db.VarChar(80)
  outcome   String   @db.VarChar(40)
  ipAddress String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([actorType, actorId, createdAt])
  @@map("auth_audit_logs")
}

model LoanProduct {
  id                  String            @id @default(cuid())
  name                String            @db.VarChar(100)
  description         String            @db.VarChar(1000)
  minimumPrincipalKes Int
  maximumPrincipalKes Int
  durationDays        Int
  interestRateBps     Int
  flatFeeKes          Int               @default(0)
  eligibilityRules    Json              @default("{}")
  termsVersion        String            @db.VarChar(40)
  isAvailable         Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  applications        LoanApplication[]

  @@index([isAvailable, name])
  @@map("loan_products")
}

model LoanApplication {
  id                    String                @id @default(cuid())
  userId                String
  productId             String
  reviewerId            String?
  requestedPrincipalKes Int
  approvedPrincipalKes  Int?
  approvedChargesKes    Int?
  status                LoanApplicationStatus @default(SUBMITTED)
  applicationData       Json                  @default("{}")
  decisionReason        String?               @db.VarChar(1000)
  requestedInformation  String?               @db.VarChar(1000)
  submittedAt           DateTime              @default(now())
  reviewedAt            DateTime?
  offerExpiresAt        DateTime?
  acceptedAt            DateTime?
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  product               LoanProduct           @relation(fields: [productId], references: [id], onDelete: Restrict)
  reviewer              SuperadminUser?       @relation(fields: [reviewerId], references: [id], onDelete: Restrict)
  loan                  Loan?

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
  @@map("loan_applications")
}

model Loan {
  id                   String              @id @default(cuid())
  applicationId        String              @unique
  userId               String
  principalKes         Int
  chargesKes           Int
  totalRepayableKes    Int
  outstandingKes       Int
  status               LoanStatus          @default(DISBURSEMENT_PENDING)
  acceptedTermsVersion String              @db.VarChar(40)
  createdAt            DateTime            @default(now())
  disbursedAt          DateTime?
  repaidAt             DateTime?
  application          LoanApplication     @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  repaymentSchedules   RepaymentSchedule[]
  repayments           Repayment[]
  disbursement         LoanDisbursement?

  @@index([userId, status])
  @@map("loans")
}

model LoanDisbursement {
  id               String             @id @default(cuid())
  loanId           String             @unique
  amountKes        Int
  currency         String             @default("KES") @db.Char(3)
  status           DisbursementStatus @default(PENDING)
  paymentReference String             @unique @db.VarChar(100)
  recordedById     String
  reason           String             @db.VarChar(500)
  createdAt        DateTime           @default(now())
  confirmedAt      DateTime?
  loan             Loan               @relation(fields: [loanId], references: [id], onDelete: Restrict)
  recordedBy       SuperadminUser     @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("loan_disbursements")
}

model PaymentTransaction {
  id                     String                         @id @default(cuid())
  internalReference      String                         @unique @db.VarChar(40)
  idempotencyKey         String                         @unique @db.VarChar(128)
  requestHash            String?                        @db.VarChar(64)
  userId                 String
  type                   PaymentType
  amountKes              Int
  currency               String                         @default("KES") @db.Char(3)
  status                 PaymentStatus                  @default(PENDING)
  provider               String                         @default("MPESA_DARAJA") @db.VarChar(32)
  providerReference      String?                        @unique @db.VarChar(100)
  receiptReference       String?                        @unique @db.VarChar(32)
  confirmedAt            DateTime?
  failureCode            String?                        @db.VarChar(40)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  user                   User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  activationRequest      ActivationPaymentRequest?
  callbackEvents         PaymentCallbackEvent[]
  reconciliationAttempts PaymentReconciliationAttempt[]
  ledgerTransaction      LedgerTransaction?
  idempotencyRecord      IdempotencyRecord?
  repayments             Repayment[]
  withdrawals            WithdrawalRequest[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("payment_transactions")
}

model ActivationPaymentRequest {
  id                    String                 @id @default(cuid())
  paymentTransactionId  String                 @unique
  userId                String
  checkoutRequestId     String?                @unique @db.VarChar(100)
  merchantRequestId     String?                @db.VarChar(100)
  callbackTokenHash     String?                @unique @db.VarChar(64)
  policySnapshot        Json?
  termsAcceptedVersion  String?                @db.VarChar(40)
  termsAcceptedAt       DateTime?
  phoneNumberCiphertext String?                @db.Text
  expiresAt             DateTime
  createdAt             DateTime               @default(now())
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentTransaction    PaymentTransaction     @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  callbackEvents        PaymentCallbackEvent[]

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@map("activation_payment_requests")
}

model PaymentCallbackEvent {
  id                         String                   @id @default(cuid())
  activationPaymentRequestId String
  paymentTransactionId       String
  payloadHash                String                   @db.VarChar(64)
  providerResultCode         String?                  @db.VarChar(40)
  providerReceiptReference   String?                  @db.VarChar(32)
  receivedAt                 DateTime                 @default(now())
  activationPaymentRequest   ActivationPaymentRequest @relation(fields: [activationPaymentRequestId], references: [id], onDelete: Restrict)
  paymentTransaction         PaymentTransaction       @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@unique([activationPaymentRequestId, payloadHash])
  @@index([receivedAt])
  @@map("payment_callback_events")
}

model PaymentReconciliationAttempt {
  id                   String             @id @default(cuid())
  paymentTransactionId String
  superadminId         String
  idempotencyKey       String             @db.VarChar(128)
  operatorNote         String             @db.VarChar(500)
  outcome              String             @default("STARTED") @db.VarChar(40)
  providerResultCode   String?            @db.VarChar(40)
  reasonCode           String?            @db.VarChar(80)
  requestedAt          DateTime           @default(now())
  completedAt          DateTime?
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)
  superadmin           SuperadminUser     @relation(fields: [superadminId], references: [id], onDelete: Restrict)

  @@unique([paymentTransactionId, idempotencyKey])
  @@index([paymentTransactionId, requestedAt])
  @@index([outcome, requestedAt])
  @@map("payment_reconciliation_attempts")
}

model LedgerAccount {
  id          String            @id @default(cuid())
  code        String            @unique @db.VarChar(40)
  name        String            @db.VarChar(120)
  accountType LedgerAccountType
  currency    String            @default("KES") @db.Char(3)
  userId      String?
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  user        User?             @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]

  @@index([userId, accountType])
  @@map("ledger_accounts")
}

model LedgerTransaction {
  id                String                  @id @default(cuid())
  internalReference String                  @unique @db.VarChar(40)
  idempotencyKey    String                  @unique @db.VarChar(128)
  transactionType   String                  @db.VarChar(40)
  requestHash       String                  @db.VarChar(64)
  status            LedgerTransactionStatus @default(POSTED)
  paymentId         String?                 @unique
  actorType         String                  @db.VarChar(20)
  actorId           String?                 @db.VarChar(80)
  reason            String?                 @db.VarChar(500)
  createdAt         DateTime                @default(now())
  payment           PaymentTransaction?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  entries           LedgerEntry[]

  @@index([transactionType, createdAt])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                  String            @id @default(cuid())
  ledgerTransactionId String
  ledgerAccountId     String
  debitKes            Int               @default(0)
  creditKes           Int               @default(0)
  createdAt           DateTime          @default(now())
  transaction         LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  account             LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([ledgerAccountId, createdAt])
  @@index([ledgerTransactionId])
  @@map("ledger_entries")
}

model IdempotencyRecord {
  id                   String              @id @default(cuid())
  scope                String              @db.VarChar(80)
  key                  String              @db.VarChar(128)
  userId               String
  paymentTransactionId String?             @unique
  responseJson         Json?
  expiresAt            DateTime
  createdAt            DateTime            @default(now())
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model SystemSetting {
  id          String          @id @default(cuid())
  key         String          @unique @db.VarChar(80)
  value       Json
  updatedById String?
  updatedAt   DateTime        @updatedAt
  updatedBy   SuperadminUser? @relation(fields: [updatedById], references: [id], onDelete: Restrict)

  @@map("system_settings")
}

model Referral {
  id             String          @id @default(cuid())
  code           String          @db.VarChar(24)
  referrerId     String
  referredUserId String          @unique
  status         ReferralStatus  @default(REGISTERED)
  riskReview     String          @default("NOT_REVIEWED") @db.VarChar(30)
  qualifiedAt    DateTime?
  createdAt      DateTime        @default(now())
  referrer       User            @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Restrict)
  referredUser   User            @relation("ReferralReferred", fields: [referredUserId], references: [id], onDelete: Restrict)
  reward         ReferralReward?

  @@index([referrerId, createdAt])
  @@index([code])
  @@index([status, createdAt])
  @@map("referrals")
}

model ReferralReward {
  id                  String   @id @default(cuid())
  referralId          String   @unique
  amountKes           Int
  status              String   @default("PENDING") @db.VarChar(24)
  ledgerTransactionId String?  @unique
  createdAt           DateTime @default(now())
  referral            Referral @relation(fields: [referralId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@map("referral_rewards")
}

model WithdrawalRequest {
  id                   String              @id @default(cuid())
  userId               String
  paymentTransactionId String?             @unique
  amountKes            Int
  payoutPhone          String              @db.VarChar(16)
  status               WithdrawalStatus    @default(REQUESTED)
  decisionReason       String?             @db.VarChar(500)
  reviewedById         String?
  requestedAt          DateTime            @default(now())
  reviewedAt           DateTime?
  completedAt          DateTime?
  user                 User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction? @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
  @@map("withdrawal_requests")
}

model RepaymentSchedule {
  id              String      @id @default(cuid())
  loanId          String
  sequence        Int
  principalDueKes Int
  chargesDueKes   Int
  amountDueKes    Int
  dueAt           DateTime
  createdAt       DateTime    @default(now())
  loan            Loan        @relation(fields: [loanId], references: [id], onDelete: Restrict)
  repayments      Repayment[]

  @@unique([loanId, sequence])
  @@index([dueAt])
  @@map("repayment_schedules")
}

model Repayment {
  id                   String             @id @default(cuid())
  loanId               String
  scheduleId           String?
  paymentTransactionId String             @unique
  principalPaidKes     Int
  chargesPaidKes       Int
  amountKes            Int
  createdAt            DateTime           @default(now())
  loan                 Loan               @relation(fields: [loanId], references: [id], onDelete: Restrict)
  schedule             RepaymentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@index([loanId, createdAt])
  @@map("repayments")
}

model SupportTicket {
  id        String              @id @default(cuid())
  reference String              @unique @db.VarChar(20)
  userId    String
  subject   String              @db.VarChar(160)
  status    SupportTicketStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages  SupportMessage[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@map("support_tickets")
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  authorType String        @db.VarChar(20)
  authorId   String        @db.VarChar(80)
  message    String        @db.VarChar(4000)
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}
